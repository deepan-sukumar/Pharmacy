# =================================================================
# PHARMAFLOW ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# -----------------------------------------------------------------
# Leave empty on Vercel to use same-origin /api serverless rewrites.
# Set only if your backend is hosted on a separate custom domain/service.
# VITE_API_BASE_URL=https://your-backend-api.vercel.app/api

# -----------------------------------------------------------------
# 2. BACKEND & VERCEL SERVERLESS ENVIRONMENT VARIABLES
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=pharmaflow-production-jwt-auth-secret-key-2026

# --- Firebase Admin SDK Credentials (Recommended for Vercel) ---
# Paste the new service account JSON into FIREBASE_SERVICE_ACCOUNT on Vercel
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"pharm-b519f",...}
FIREBASE_PROJECT_ID=pharm-b519f

# --- Gemini AI Assistant (Server-Side Only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Active SMS Provider: MESSAGECENTRAL | SMSLOCAL | FAST2SMS ---
SMS_PROVIDER=MESSAGECENTRAL

# MessageCentral Configuration
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_API_KEY=
MESSAGECENTRAL_AUTH_TOKEN=
MESSAGECENTRAL_BASE_URL=https://cpaas.messagecentral.com

# SMSLocal India DLT Gateway
SMSLOCAL_API_KEY=
SMSLOCAL_MODE=live
SMSLOCAL_SENDER_ID=PHFLOW
SMSLOCAL_TEMPLATE_ID=110716182910001
SMS_DLT_TEMPLATE_ID_EXPIRY=110716182910001
SMS_DLT_TEMPLATE_ID_RECALL=110716182910002
SMSLOCAL_BASE_URL=https://app.smslocal.in/api/smsapi
SMSLOCAL_DLR_URL=https://app.smslocal.in/api/dlrapi
SMSLOCAL_CREDIT_URL=https://app.smslocal.in/api/creditapi
