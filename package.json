{
  "name": "pharmaflow-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "PharmaFlow: Pharmacy Medication Dispensing Audit, Expiry Tracking & Real SMS Management Portal",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm test --workspace=backend",
    "test:backend": "npm test --workspace=backend",
    "typecheck": "npm run typecheck --workspace=frontend",
    "install:all": "npm install"
  }
}

